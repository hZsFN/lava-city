      "id": "a1_first_tower",
      "trigger": { "kind": "event", "event": "TowerPlaced" },
      "window": { "fromSec": 16, "toSec": 50 },
      "priority": 11,
      "durationMs": 2800,
      "world": "surface",
      "speaker": "引路人",
      "text": "塔不是墙。\n塔是你肯留下的一部分。"
    },
    {
      "id": "a1_prep",
      "trigger": { "kind": "phase", "phase": "prep" },
      "priority": 10,
      "durationMs": 3000,
      "world": "surface",
      "speaker": "引路人",
      "text": "他快上来了。\n最后看一眼你建的这些东西。"
    },


  "cues": [
    {
      "id": "a1_run",
      "trigger": { "kind": "phaseProgress", "phase": "wake", "pct": 25 },
      "priority": 10,
      "durationMs": 3600,
      "world": "surface",
      "text": "你还记得自己在跑。\n你不记得跑向哪里。"
    },
    {
      "id": "a1_faces",
      "trigger": { "kind": "phaseProgress", "phase": "wake", "pct": 62 },
      "priority": 20,
      "durationMs": 2600,
      "world": "inner",
      "holdInnerMs": 500,
      "letterbox": true,
      "text": "往下走的人，背影一模一样。\n你数到第七个就醒了。"
    },
    {
      "id": "a1_keeper_intro",
      "trigger": { "kind": "phaseProgress", "phase": "wake", "pct": 92 },
      "priority": 10,
      "durationMs": 3400,
      "world": "surface",
      "speaker": "引路人",
      "altOnReplay": "a1_keeper_intro_r2",
      "text": "塔心还亮着。说明有人替你守过。\n别浪费。"
    },
    {
      "id": "a1_build_teach",
      "trigger": { "kind": "phaseProgress", "phase": "tutorial", "pct": 45 },
      "priority": 10,
      "durationMs": 3400,
      "world": "surface",
      "speaker": "引路人",
      "text": "石头记得形状。\n把塔建在它想站的地方。"
    },

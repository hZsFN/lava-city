{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"],
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "../../src/player/**/*.ts",
    "../../src/combat/**/*.ts",
    "../../src/core/events.ts",
    "**/*.ts"
  ],
  "exclude": ["node_modules"]
}
{
  "name": "lava-city",
  "private": true,
  "version": "0.1.0",
  "description": "《熔心孤塔》单人关卡：第一人称塔防 x Boss 战",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File tools/pack-level.ps1",
    "gate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gate.ps1",
    "contract": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-contract.ps1"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.4"
  }
}

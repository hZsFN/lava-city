  "batches": {
    "_comment": "静态几何合并进这些批次，每批 1 个 draw call。",
    "rock": { "material": "rockMaterial", "reuseFrom": "src/render/Spire.ts" },
    "obsidian": { "material": "obsidianMaterial", "reuseFrom": "src/render/Spire.ts" },
    "rune": { "material": "runeMaterial", "reuseFrom": "src/render/Spire.ts" },
    "wardRune": {
      "material": "wardRuneMaterial",
      "isNew": true,
      "params": {
        "color": "#0a0706",
        "roughness": 0.78,
        "metalness": 0.15,
        "emissive": "#9fe9ff",
        "emissiveIntensity": 0.9,
        "flatShading": true
      },
      "reason": "护壁符文是冷青（防御物语义），但必须压到 0.9，远低于灯塔的 2.2+，避免抢地脉灯塔的视觉锚点地位。"
    },
    "debris": {
      "material": "rockMaterial",
      "isInstanced": true,
      "maxInstances": 64,
      "reason": "碎片池，1 个 draw call。"
    }
  },

  "visualGrammar": {
    "principle": "光只从下面来（M1-03），可读性不能靠表面明度，只能靠 轮廓 + 底部反光 + 符文。",

      "slagBulwark": "三块错位岩板，最高一块偏左，锯齿状不平整",
      "obsidianPillar": "六棱柱，顶端斜切 15°，细高尖，有镜面棱线",
      "brokenParapet": "两块矮石，中间 0.3 m 缺口，低、断",
      "coreWard": "弧形墙，顶部内倾 10°，包住塔心",
      "frostAnchor": "矮圆台 + 中央细铁针，地面有光环",
      "platform": "正八边形平板，边缘倒角，规整几何"
    },
    "runePolicy": {
      "cover": "橙色符文（#ff9a3c，比熔岩 #ff5a12 更黄，外圈加 1px 暗边）",
      "defense": "冷青符文（#9fe9ff，emissiveIntensity 0.9）",
      "platform": "无符文（面），只有边缘描边（边）—— 面会让人误以为有魔法效果"
    }
  },


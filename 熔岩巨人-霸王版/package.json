{
  "name": "surtr-rig",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "苏尔特（熔岩巨人）程序化模型构建器 + 工具链",
  "scripts": {
    "build": "node tools/build.mjs",
    "shot": "node tools/shot.mjs",
    "shot:full": "node tools/shot.mjs --params-p1=exposure=0.75,bloom=0.75 --params-p2=exposure=0.6,bloom=0.5",
    "verify": "node tools/verify.mjs",
    "typecheck": "node tools/typecheck.mjs",
    "check": "node tools/build.mjs && node tools/typecheck.mjs && node tools/verify.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "canvas": "^3.2.3",
    "typescript": "^5.6.3"
  }
}
